# Cray Hosted Checkout — keep the real values in your host's env settings (e.g. Coolify), never in git.
CRAY_BASE_URL=https://your-cray-api-base-url
CRAY_SECRET_KEY=sk_live_your_secret_key
# Subaccount to collect card payments into (from GET /api/get-subaccount).
CRAY_SUBACCOUNT_TOKEN=
# Optional: public origin used to build the post-payment callback URL (defaults to the request's host).
SITE_URL=
# Orders database (Postgres). Append ?sslmode=require once SSL is enabled on the server.
DATABASE_URL=postgres://webreid:password@host:5432/webreid
